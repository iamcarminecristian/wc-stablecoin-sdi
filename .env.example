# Copiare in .env alla root del repo (cp .env.example .env) e compilare i
# valori vuoti. Un solo file per tutto il monorepo: watcher, spike e
# strumenti di campagna lo caricano per path relativo, non dalla cwd.
# I segreti non vanno mai committati: .env e' escluso da .gitignore.
# Le variabili gia' presenti nell'ambiente hanno la precedenza sul file.

# --- Monerium sandbox (api.monerium.dev) ---
# Produzione e' api.monerium.app: non usarla.
# Credenziali dell'applicazione (piano Private) dal developer portal.
MONERIUM_BASE_URL=https://api.monerium.dev
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
# Indirizzo di incasso dell'esercente, collegato al profilo presso
# l'emittente. E' l'indirizzo che il contratto di inoltro ha come
# destinatario immutabile.
MONERIUM_WALLET_ADDRESS=
MONERIUM_CHAIN=basesepolia

# IBAN di accredito del riscatto, da GET /ibans del proprio profilo.
# Deve risultare collegato a MONERIUM_WALLET_ADDRESS sulla rete in uso: il
# watcher lo verifica all'avvio.
MONERIUM_IBAN=

# Anagrafica del beneficiario del riscatto (counterpart.details).
# L'emittente rifiuta l'ordine senza nome e cognome; il paese e' facoltativo.
MERCHANT_FIRST_NAME=
MERCHANT_LAST_NAME=
MERCHANT_COUNTRY=

# Unica chiave privata del sistema: quella dell'esercente sul proprio
# indirizzo di incasso, necessaria a firmare gli ordini di riscatto (EIP-191).
# Vive nel servizio di rilevamento e mai nel plugin (RNF-02, tesi par. 4.4).
MERCHANT_SIGNER_PRIVATE_KEY=

# --- Rete: Base Sepolia (watcher, campagne) ---
# Unica rete di prova con IBAN collegato nel sandbox dell'emittente. Gnosis
# Chiado e' abilitato ma senza IBAN: non usarlo per i test.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Contratto EURe sulla rete in uso (GET /tokens dell'emittente). Serve al
# watcher per la verifica di avvio sulla lista nera del validatore e agli
# strumenti di campagna.
TOKEN_ADDRESS=
TOKEN_DECIMALS=18

# Indirizzo osservato dal ripiego sugli eventi Transfer (solo confronto in
# tesi) e destinatario del contratto di inoltro alla pubblicazione.
WATCH_ADDRESS=

# Contratto di inoltro (contracts/), che correla il pagamento all'ordine.
# Impostato: il rilevamento osserva gli eventi OrderPaid del contratto.
# Vuoto: ripiega sugli eventi Transfer del token, che non portano causale.
FORWARDER_ADDRESS=

# Criterio di conferma. Se assenti, il watcher li legge dal pannello del
# plugin (GET /config); se presenti, hanno la precedenza (le campagne li
# variano). Valori: confirmations (con CONFIRMATIONS=N), safe, finalized.
# Predefinito, in assenza di entrambi: finalized.
FINALITY_MODE=
CONFIRMATIONS=
# Intervallo di sondaggio in millisecondi. Predefinito: 5000 con le
# conferme, 30000 con le etichette.
POLL_MS=

# Ampiezza massima di una query sui log: i provider pubblici la limitano.
MAX_BLOCK_SPAN=500

# Blocco di partenza alla primissima accensione. Senza, si parte dalla testa
# della catena e gli eventi anteriori non vengono visti.
START_BLOCK=

# File di stato del watcher (predefinito: watcher/state.json). Contiene
# l'ultimo blocco, gli eventi in attesa e notificati, i riscatti, gli orfani.
WATCHER_STATE_FILE=

# --- Servizio di rilevamento: dialogo con il plugin ---
# Endpoint REST del plugin. L'immagine Docker di WordPress non riscrive
# /wp-json/: si usa la forma con rest_route. Su un'installazione con i
# permalink attivi: https://negozio.example/wp-json/wcsdi/v1
WCSDI_PLUGIN_URL=http://localhost:8080/?rest_route=/wcsdi/v1
# Segreto condiviso per autenticare le notifiche. Va impostato identico nel
# pannello del gateway (campo «Segreto del servizio di rilevamento») oppure
# con: wp option update wcsdi_watcher_secret <valore>
# Generarlo con: openssl rand -hex 32
WCSDI_SHARED_SECRET=

# Riscatto automatico verso l'IBAN dell'esercente (RF-05). Con false i
# pagamenti vengono solo notificati.
AUTO_REDEEM=true
# Intervallo con cui il watcher segue l'esito dei riscatti in corso (ms).
RISCATTO_POLL_MS=15000

# --- Openapi SdI sandbox (test.sdi.openapi.it) ---
# Produzione e' sdi.openapi.it: non usarla.
# Bearer token della sezione Autenticazione della dashboard, tipo Sandbox.
# NON la "API Key" mostrata piu' in alto nella stessa pagina: sono due
# credenziali distinte. Prerequisito: impostare il credito sandbox da
# dashboard, anche se le richieste di test sono gratuite.
OPENAPI_SDI_BASE_URL=https://test.sdi.openapi.it
OPENAPI_SDI_TOKEN=

# Partita IVA o codice fiscale personale, senza prefisso IT.
OPENAPI_FISCAL_ID=

# --- Banco di prova (tools/local-chain/campagna*.mjs) ---
# Chiave del cliente simulato, identita' distinta dall'esercente: un
# pagamento verso se stessi non riproduce il flusso. Obbligatoria su
# qualsiasi rete diversa da anvil (31337), dove vale l'account pubblico.
CAMPAGNA_PAYER_KEY=
