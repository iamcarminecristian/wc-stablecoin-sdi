# Copiare in .env alla root del repo (cp .env.example .env) e compilare i
# valori vuoti. Un solo file per tutto il monorepo: gli spike lo caricano per
# path relativo, non dalla cwd.
# I segreti non vanno mai committati: .env e' escluso da .gitignore.

# --- Monerium sandbox (api.monerium.dev) ---
# Produzione e' api.monerium.app: non usarla.
# Credenziali dell'applicazione (piano Private) dal developer portal.
MONERIUM_BASE_URL=https://api.monerium.dev
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
MONERIUM_WALLET_ADDRESS=
MONERIUM_CHAIN=basesepolia

# IBAN di accredito del redemption, da GET /profiles del proprio profilo.
MONERIUM_IBAN=

# --- Chain: Base Sepolia (spike 1, watcher) ---
# Unica chain con IBAN approvato sul wallet. Gnosis Chiado e' abilitato ma
# senza IBAN: non usarlo per i test.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Indirizzo del contratto EURe su Base Sepolia: si ottiene da GET /tokens
# (spike 2) e va incollato qui prima di lanciare lo spike 1.
TOKEN_ADDRESS=
WATCH_ADDRESS=
TOKEN_DECIMALS=18

# Contratto di inoltro (contracts/), che correla il pagamento all'ordine.
# Impostato: il rilevamento osserva gli eventi OrderPaid del contratto.
# Vuoto: ripiega sugli eventi Transfer del token, che non portano causale.
FORWARDER_ADDRESS=
CONFIRMATIONS=12
POLL_MS=5000

# --- Openapi SdI sandbox (test.sdi.openapi.it) ---
# Produzione e' sdi.openapi.it: non usarla.
# Bearer token della sezione Autenticazione della dashboard, tipo Sandbox.
# NON la "API Key" mostrata piu' in alto nella stessa pagina: sono due
# credenziali distinte. Prerequisito: impostare il credito sandbox da
# dashboard, anche se le richieste di test sono gratuite.
OPENAPI_SDI_BASE_URL=https://test.sdi.openapi.it
OPENAPI_SDI_TOKEN=

# Partita IVA o codice fiscale personale, senza prefisso IT.
OPENAPI_FISCAL_ID=

# --- Firma degli ordini di redemption (solo spike 2) ---
# Monerium richiede una firma EIP-191 del wallet che detiene gli EURe: il
# token OAuth da solo non basta a muovere fondi. Questa variabile serve
# esclusivamente al banco di prova su testnet, con fondi simulati.
# NON deve mai finire nel plugin ne' nella sua configurazione (RNF-02):
# dove viva la chiave nel sistema reale e' una scelta architetturale
# ancora aperta, isolata nella funzione firma() dello spike 2.
MERCHANT_SIGNER_PRIVATE_KEY=

# --- Servizio di rilevamento (watcher) ---
# Endpoint REST del plugin e segreto condiviso per autenticare le notifiche.
# Il segreto va impostato identico anche nell'opzione WordPress
# wcsdi_watcher_secret: wp option update wcsdi_watcher_secret <valore>
WCSDI_PLUGIN_URL=http://localhost:8080/wp-json/wcsdi/v1
WCSDI_SHARED_SECRET=

# Blocco di partenza alla primissima accensione. Senza, si parte dalla testa
# della catena e gli eventi anteriori non vengono visti.
START_BLOCK=

# Ampiezza massima di una query sui log: i provider pubblici la limitano.
MAX_BLOCK_SPAN=500

# Rimborso automatico verso l'IBAN dell'esercente (RF-05).
AUTO_REDEEM=true

# Unica chiave privata del sistema: quella dell'esercente sul proprio
# indirizzo di incasso, necessaria a firmare gli ordini di rimborso. Vive nel
# servizio di rilevamento e mai nel plugin (RNF-02, tesi §4.4).
MERCHANT_SIGNER_PRIVATE_KEY=
